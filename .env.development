# The settings below can be overriden in a .env.development.local file.

# Kiwi will randomically pick one of the URLs in a semicolon separated list
# of URLS assigned to the VITE_REACT_APP_WEBSOCKET_PROXY_SERVER_BASE_URL variable.
# VITE_REACT_APP_WEBSOCKET_PROXY_SERVER_BASE_URL="ws://localhost:8070/ws_channel;ws://localhost:8071/ws_channel"

# When the variable below is defined, Kiwi will support specification of the GUI Server to
# connect to either by "topic" or by "host:port". Otherwise, only specification by "host:port"
# will be supported.
# VITE_REACT_APP_TOPIC_SERVER_MAP="SA1:localhost:44440;SA2:localhost:44454;SA3:localhost:44448"
